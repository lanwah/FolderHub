<Window x:Class="FolderHub.CardHost.Views.CardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FolderHub Card"
        Width="200" Height="128"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseDoubleClick="Window_MouseDoubleClick"
        ContextMenuOpening="Window_ContextMenuOpening">
  <Window.Resources>
    <ContextMenu x:Key="CardMenu" Style="{StaticResource AppContextMenu}">
      <MenuItem Header="↗　打开文件夹" Click="Open_Click"/>
      <MenuItem Header="⌖　锁定/解锁位置" Click="Lock_Click"/>
      <Separator Style="{StaticResource AppMenuSeparator}"/>
      <MenuItem Header="⊖　取消固定" Style="{StaticResource DangerMenuItem}"
                Click="CloseCard_Click"/>
    </ContextMenu>
  </Window.Resources>

  <!-- design-demo .desktop-widget：14px 圆角、毛玻璃底、14px padding -->
  <Border x:Name="RootBorder"
          CornerRadius="14"
          BorderBrush="{DynamicResource WidgetBorderBrush}"
          BorderThickness="1"
          Background="{DynamicResource WidgetBgBrush}"
          Padding="14"
          Cursor="SizeAll">
    <Border.Effect>
      <DropShadowEffect BlurRadius="36" ShadowDepth="14" Opacity="0.25" Color="#061820"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" LastChildFill="False">
        <!-- design-demo .widget-icon：30×30 / radius 9；优先 images PNG -->
        <Border x:Name="IconToneBorder" Width="30" Height="30" CornerRadius="9" ClipToBounds="True"
                Background="{DynamicResource FolderIconToneBrush}" DockPanel.Dock="Left">
          <Grid>
            <Image x:Name="CustomIconImage" Stretch="UniformToFill" Visibility="Collapsed"/>
            <TextBlock x:Name="IconGlyphText" FontSize="16"
                       FontFamily="Segoe UI Symbol, Segoe UI Emoji, Microsoft YaHei UI"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center"/>
          </Grid>
        </Border>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <!-- 开锁/关锁图标，替代难辨认的 ⌑；与 design-demo .widget-lock 对齐 -->
          <Button x:Name="LockButton" Width="24" Height="24" Margin="0,0,4,0"
                  ToolTip="锁定位置" Click="Lock_Click"
                  Background="Transparent" BorderThickness="0"
                  Foreground="{DynamicResource InkSoftBrush}" Cursor="Hand"
                  Padding="0">
            <Viewbox Width="14" Height="14" Stretch="Uniform">
              <Canvas Width="16" Height="16">
                <Path x:Name="LockShacklePath"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" Fill="Transparent"
                      Data="M5,7.25 L5,5 A3,3 0 0 1 10.7,3.65"/>
                <Rectangle Canvas.Left="3.25" Canvas.Top="7.25"
                           Width="9.5" Height="6.5" RadiusX="1.75" RadiusY="1.75"
                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                           StrokeThickness="1.75" Fill="Transparent"/>
                <Ellipse Width="2" Height="2" Canvas.Left="7" Canvas.Top="9.5"
                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              </Canvas>
            </Viewbox>
          </Button>
          <Button Content="×" Width="24" Height="24"
                  ToolTip="取消固定" Click="CloseCard_Click"
                  Background="Transparent" BorderThickness="0"
                  Foreground="{DynamicResource MutedBrush}" Cursor="Hand" FontSize="16" FontWeight="SemiBold"/>
        </StackPanel>
      </DockPanel>

      <TextBlock x:Name="TitleText" Grid.Row="1" Margin="0,10,0,0"
                 FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                 TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="DescText" Grid.Row="2" Margin="0,4,0,0"
                 FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                 MaxHeight="36" TextTrimming="CharacterEllipsis" LineHeight="16.8"/>
      <TextBlock x:Name="HintText" Grid.Row="3" Margin="0,8,0,0"
                 FontSize="11" Foreground="{DynamicResource MutedSoftBrush}"/>
    </Grid>
  </Border>
</Window>
