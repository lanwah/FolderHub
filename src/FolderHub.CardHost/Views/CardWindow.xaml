<Window x:Class="FolderHub.CardHost.Views.CardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FolderHub Card"
        Width="190" Height="128"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseDoubleClick="Window_MouseDoubleClick"
        ContextMenuOpening="Window_ContextMenuOpening">
  <Window.Resources>
    <ContextMenu x:Key="CardMenu">
      <MenuItem Header="打开文件夹" Click="Open_Click"/>
      <MenuItem Header="锁定/解锁位置" Click="Lock_Click"/>
      <Separator/>
      <MenuItem Header="取消固定" Click="CloseCard_Click"/>
    </ContextMenu>
  </Window.Resources>

  <Border x:Name="RootBorder"
          CornerRadius="14"
          BorderBrush="#80FFFFFF"
          BorderThickness="1"
          Background="#D9FFFFFF"
          Padding="14"
          Cursor="SizeAll">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" Color="#102C2C"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" LastChildFill="False">
        <Border Width="28" Height="28" CornerRadius="9" Background="#E5F1ED" DockPanel.Dock="Left">
          <TextBlock Text="📁" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button x:Name="LockButton" Content="⌑" Width="22" Height="22" Margin="0,0,2,0"
                  ToolTip="锁定/解锁" Click="Lock_Click"
                  Background="Transparent" BorderThickness="0" Foreground="#82918C" Cursor="Hand"
                  FontSize="12"/>
          <Button Content="×" Width="22" Height="22"
                  ToolTip="取消固定" Click="CloseCard_Click"
                  Background="Transparent" BorderThickness="0" Foreground="#82918C" Cursor="Hand"
                  FontSize="14"/>
        </StackPanel>
      </DockPanel>

      <TextBlock x:Name="TitleText" Grid.Row="1" Margin="0,10,0,0"
                 FontSize="11" FontWeight="Bold" Foreground="#263B37"
                 TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="DescText" Grid.Row="2" Margin="0,4,0,0"
                 FontSize="9" Foreground="#788984" TextWrapping="Wrap"
                 MaxHeight="36" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="HintText" Grid.Row="3" Margin="0,8,0,0"
                 FontSize="8" Foreground="#A0AAA5"/>
    </Grid>
  </Border>
</Window>
