<Window x:Class="FolderHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FolderHub.App.ViewModels"
        Title="FolderHub"
        Height="560" Width="920"
        MinHeight="420" MinWidth="720"
        WindowStartupLocation="Manual"
        Background="#F3F6F4"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <ContextMenu x:Key="FolderMenu">
      <MenuItem Header="打开文件夹" Click="ContextOpen_Click"/>
      <MenuItem Header="重新指定路径" Click="ContextEdit_Click"/>
      <MenuItem Header="编辑记录" Click="ContextEdit_Click"/>
      <MenuItem Header="固定到桌面" Click="ContextPin_Click"/>
      <Separator/>
      <MenuItem Header="删除记录" Click="ContextDelete_Click"/>
    </ContextMenu>
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#68747D"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F0F4F3"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CategoryButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Height" Value="39"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#EDF3F0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Background" Value="#E5F1ED"/>
          <Setter Property="Foreground" Value="#236B5E"/>
          <Setter Property="FontWeight" Value="Bold"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Border x:Name="RootChrome" CornerRadius="12" BorderBrush="#DDE6E2" BorderThickness="1" Background="#FFFFFFFF">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="#102B3B"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="54"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <Border Grid.Row="0" BorderBrush="#EDF0F1" BorderThickness="0,0,0,1" Background="#FFFFFF"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="20,0,12,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="24" Height="24" CornerRadius="7"
                    Background="#287C70" Margin="0,0,10,0">
              <TextBlock Text="F" Foreground="White" FontWeight="Bold" FontSize="13"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="FolderHub" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
            <TextBlock Text="文件夹快速访问" Margin="12,0,0,0" FontSize="11" Foreground="#9AA4AB"
                       VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Style="{StaticResource IconButton}" Content="⚙" ToolTip="设置"
                    Command="{Binding OpenSettingsCommand}"/>
            <Button Style="{StaticResource IconButton}" Content="—" ToolTip="最小化" Click="Minimize_Click"/>
            <Button Style="{StaticResource IconButton}" Content="×" ToolTip="关闭" Click="Close_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Body -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="226"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#F7F9F8" BorderBrush="#EDF0EF" BorderThickness="0,0,1,0">
          <DockPanel Margin="14,24,14,16">
            <Grid DockPanel.Dock="Top" Margin="9,0,9,13">
              <TextBlock Text="工作空间" FontSize="10" FontWeight="Bold" Foreground="#8B979B"
                         VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="＋" ToolTip="新增分类" Command="{Binding AddCategoryCommand}"
                        Width="25" Height="25" Background="Transparent" BorderThickness="0"
                        Foreground="#74827F" FontSize="16" Cursor="Hand"/>
                <Button Content="✎" ToolTip="重命名分类" Command="{Binding RenameCategoryCommand}"
                        Width="25" Height="25" Background="Transparent" BorderThickness="0"
                        Foreground="#74827F" Cursor="Hand"/>
                <Button Content="×" ToolTip="删除分类" Command="{Binding DeleteCategoryCommand}"
                        Width="25" Height="25" Background="Transparent" BorderThickness="0"
                        Foreground="#74827F" Cursor="Hand"/>
              </StackPanel>
            </Grid>

            <Border DockPanel.Dock="Bottom" BorderBrush="#E7ECE9" BorderThickness="1" CornerRadius="12"
                    Background="White" Padding="10,13" Margin="0,12,0,0">
              <StackPanel Orientation="Horizontal">
                <Border Width="31" Height="31" CornerRadius="9" Background="#EDF5F2" Margin="0,0,10,0">
                  <TextBlock Text="▦" Foreground="#287C70" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="文件夹库" FontSize="11" FontWeight="SemiBold"/>
                  <TextBlock FontSize="10" Foreground="#9AA4A1" Margin="0,3,0,0">
                    <Run Text="{Binding TotalFolderCount, Mode=OneWay}"/>
                    <Run Text=" 个文件夹记录"/>
                  </TextBlock>
                </StackPanel>
              </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Categories}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:CategoryListItem}">
                  <Button Style="{StaticResource CategoryButton}"
                          Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                      <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="10" Foreground="#9AA5A2"
                                 VerticalAlignment="Center"/>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>

        <!-- Content -->
        <Border x:Name="ContentPanel" Grid.Column="1" Background="#FFFFFFFF" Padding="32,29,32,17">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,22">
              <StackPanel>
                <TextBlock Text="YOUR WORKSPACE" FontSize="9" FontWeight="Bold" Foreground="#8FA19B"/>
                <TextBlock Text="{Binding CurrentCategoryTitle}" FontSize="25" FontWeight="SemiBold"
                           Foreground="#1B2B31" Margin="0,7,0,0"/>
                <TextBlock Text="{Binding CurrentCategorySubtitle}" FontSize="11" Foreground="#8C989B" Margin="0,7,0,0"/>
              </StackPanel>
              <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="37" Padding="14,0"
                      Background="#287C70" Foreground="White" BorderThickness="0" Cursor="Hand"
                      FontWeight="SemiBold" FontSize="11" Command="{Binding AddFolderCommand}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="＋" FontSize="16" Margin="0,0,4,0"/>
                  <TextBlock Text="添加文件夹" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Grid>

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18" LastChildFill="True">
              <TextBlock DockPanel.Dock="Right" Text="{Binding ResultCountText}" VerticalAlignment="Center"
                         Margin="12,0,0,0" FontSize="10" Foreground="#9AA5A1"/>
              <Border Height="38" BorderBrush="#E7ECEB" BorderThickness="1" CornerRadius="9" Background="#FAFCFB">
                <DockPanel Margin="11,0">
                  <TextBlock DockPanel.Dock="Left" Text="⌕" FontSize="16" Foreground="#8B9995"
                             VerticalAlignment="Center" Margin="0,0,9,0"/>
                  <TextBlock DockPanel.Dock="Right" Text="Ctrl+K" FontSize="9" Foreground="#A5AEAB"
                             VerticalAlignment="Center" Margin="8,0,0,0"
                             Background="#F0F3F2" Padding="5,3"/>
                  <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                           VerticalContentAlignment="Center" FontSize="12"
                           Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                           Tag="搜索文件夹名称或别名…"/>
                </DockPanel>
              </Border>
            </DockPanel>

            <Border DockPanel.Dock="Bottom" BorderBrush="#EFF2F1" BorderThickness="0,1,0,0" Padding="0,12,0,0"
                    Margin="0,10,0,0">
              <DockPanel>
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="6" Height="6" Fill="#63C6A6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="#A2ACA8"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="WP4 · Shell" FontSize="10" Foreground="#A2ACA8"
                           HorizontalAlignment="Right"/>
              </DockPanel>
            </Border>

            <Grid>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Folders}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FolderListItem}">
                      <Border Margin="6" Padding="14" MinHeight="140" CornerRadius="12" Cursor="Hand"
                              BorderThickness="1" Background="White"
                              MouseLeftButtonUp="FolderCard_MouseLeftButtonUp"
                              MouseRightButtonUp="FolderCard_MouseRightButtonUp"
                              MouseLeftButtonDown="FolderCard_MouseLeftButtonDown"
                              Tag="{Binding}">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#E9EEEC"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="#7BB5A6"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsPathUnavailable}" Value="True">
                                <Setter Property="BorderBrush" Value="#D9A06A"/>
                                <Setter Property="Background" Value="#FFFBF6"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <DockPanel>
                          <DockPanel DockPanel.Dock="Top">
                            <Border Width="37" Height="37" CornerRadius="11" Background="#EDF3FF">
                              <TextBlock Text="📁" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Button DockPanel.Dock="Right" Content="···" Width="24" Height="24"
                                    Background="Transparent" BorderThickness="0" Foreground="#A7B0AE"
                                    HorizontalAlignment="Right" Click="FolderMore_Click"
                                    Tag="{Binding}"/>
                          </DockPanel>
                          <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <TextBlock Text="{Binding PathStatusLabel}" FontSize="9"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="#AAB4B0"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPathUnavailable}" Value="True">
                                      <Setter Property="Foreground" Value="#B8753A"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <Button DockPanel.Dock="Right" Content="{Binding PinLabel}" FontSize="9" Padding="7,4"
                                    Margin="8,0,0,0" Background="White" BorderBrush="#E8EEEB"
                                    Foreground="#82908B" Click="Pin_Click" Tag="{Binding}"/>
                          </DockPanel>
                          <StackPanel Margin="0,13,0,0">
                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="#2A3936"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="9" Foreground="#9BA7A3" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#8A9793"
                                       TextWrapping="Wrap" MaxHeight="36" Margin="0,8,0,0"/>
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="⌕" FontSize="30" HorizontalAlignment="Center" Foreground="#87938F"/>
                <TextBlock Text="没有找到匹配的文件夹" FontWeight="SemiBold" FontSize="13"
                           Foreground="#87938F" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock Text="可从资源管理器拖入文件夹，或点击「添加文件夹」" FontSize="10" Foreground="#87938F"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
              </StackPanel>
            </Grid>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
