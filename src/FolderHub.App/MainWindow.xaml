<Window x:Class="FolderHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:vm="clr-namespace:FolderHub.App.ViewModels"
        Title="FolderHub"
        Height="720" Width="1100"
        MinHeight="560" MinWidth="760"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="14"
        Foreground="{DynamicResource InkBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <!-- 网格：双列拉满（对齐设计稿每行 2 卡）；列表：Width=Auto（NaN）单列拉满
         最小高度对齐 design-demo min-height:168；固定 Height 会把说明行 * 压到数 px 并裁字 -->
    <sys:Double x:Key="FolderCardMinHeight">168</sys:Double>
    <sys:Double x:Key="DoubleAuto">NaN</sys:Double>
    <ContextMenu x:Key="FolderMenu" Style="{StaticResource AppContextMenu}">
      <MenuItem Header="↗　打开文件夹" Click="ContextOpen_Click"/>
      <MenuItem Header="↻　重新指定路径" Click="ContextEdit_Click"/>
      <MenuItem Header="✎　编辑记录" Click="ContextEdit_Click"/>
      <MenuItem Header="⊕　固定到桌面" Click="ContextPin_Click"/>
      <Separator Style="{StaticResource AppMenuSeparator}"/>
      <MenuItem Header="×　删除记录" Style="{StaticResource DangerMenuItem}"
                Click="ContextDelete_Click"/>
    </ContextMenu>
  </Window.Resources>

  <!-- Margin 留给窗外阴影；窗口客户区 = 内容 + 40。
       阴影与内容分两层：Effect 不能与 Clip 同层，否则圆角外阴影被裁掉；
       RootChrome 在 SizeChanged 里按 CornerRadius 裁剪，避免标题栏/侧栏直角露出。 -->
  <Grid Margin="20">
    <Border CornerRadius="18" Background="#01061820" IsHitTestVisible="False">
      <Border.Effect>
        <DropShadowEffect BlurRadius="64" ShadowDepth="24" Opacity="0.33" Color="#061820"/>
      </Border.Effect>
    </Border>
    <Border x:Name="RootChrome" CornerRadius="18"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1"
            Background="{DynamicResource PanelBrush}"
            SizeChanged="RootChrome_SizeChanged">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Title bar (demo .window-titlebar) -->
      <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
              Background="{DynamicResource PanelBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="18,0,14,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="24" Height="24" CornerRadius="7" Margin="0,0,10,0"
                    Background="{DynamicResource BrandMarkBrush}">
              <TextBlock Text="F" Foreground="White" FontWeight="ExtraBold" FontSize="13"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="FolderHub" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"
                       Foreground="{DynamicResource InkBrush}"/>
            <Border Width="1" Height="12" Background="{DynamicResource LineBrush}" Margin="12,0,10,0"
                    VerticalAlignment="Center"/>
            <TextBlock Text="文件夹快速访问" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Style="{DynamicResource IconButton}" x:Name="ThemeToggleBtn" Content="☾"
                    ToolTip="切换浅色/深色主题" Click="ThemeToggle_Click"/>
            <Button Style="{DynamicResource IconButton}" Content="—" ToolTip="隐藏主组件" Click="Minimize_Click"/>
            <Button Style="{DynamicResource IconButton}" Content="☕" ToolTip="Buy me a coffee"
                    Command="{Binding OpenDonationCommand}"/>
            <Button Style="{DynamicResource IconButton}" Content="⚙" ToolTip="设置"
                    Command="{Binding OpenSettingsCommand}"/>
            <Button Style="{DynamicResource IconButton}" Content="×" ToolTip="隐藏主组件" Tag="close"
                    Click="Close_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Body -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="228"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource PanelSidebarBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
          <DockPanel Margin="12,22,12,14">
            <Grid DockPanel.Dock="Top" Margin="8,0,8,12">
              <TextBlock Text="工作空间" FontSize="11" FontWeight="Bold"
                         Foreground="{DynamicResource MutedBrush}"
                         VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{DynamicResource TextIconButton}" Content="＋" ToolTip="新增分类"
                        Command="{Binding AddCategoryCommand}"/>
                <Button Style="{DynamicResource TextIconButton}" Content="✎" ToolTip="编辑分类"
                        FontSize="14" Command="{Binding RenameCategoryCommand}"/>
                <Button Style="{DynamicResource TextIconButton}" Content="×" ToolTip="删除分类"
                        FontSize="16" Command="{Binding DeleteCategoryCommand}"/>
              </StackPanel>
            </Grid>

            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="12" Background="{DynamicResource PanelBrush}" Padding="10,12" Margin="0,12,0,0">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Border Width="34" Height="34" CornerRadius="10" Margin="0,0,10,0"
                          Background="{DynamicResource AccentSoftBrush}">
                    <TextBlock Text="▦" Foreground="{DynamicResource AccentBrush}" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="文件夹库" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource InkBrush}"/>
                    <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0">
                      <Run Text="{Binding TotalFolderCount, Mode=OneWay}"/>
                      <Run Text=" 个文件夹记录"/>
                    </TextBlock>
                  </StackPanel>
                </StackPanel>
                <TextBlock Text="REQ-BL-1.0 · FolderHub" FontSize="11"
                           Foreground="{DynamicResource MutedSoftBrush}" Margin="6,12,0,0"/>
              </StackPanel>
            </Border>

            <ItemsControl x:Name="CategoryList" ItemsSource="{Binding Categories}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:CategoryListItem}">
                  <Button Style="{DynamicResource CategoryButton}"
                          Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <!-- 跟稿：分类侧栏用几何符号（继承 Foreground），不用固定色 PNG，避免错位/选中色丢失 -->
                      <TextBlock Width="18" Text="{Binding IconGlyph}" FontSize="14"
                                 TextAlignment="Center" VerticalAlignment="Center"
                                 FontFamily="Segoe UI Symbol, Segoe UI Emoji, Microsoft YaHei UI"
                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                 Margin="10,0,0,0"
                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                      <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="11"
                                 Foreground="{DynamicResource MutedSoftBrush}" VerticalAlignment="Center"
                                 FontWeight="Medium"/>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>

        <!-- Content -->
        <Border x:Name="ContentPanel" Grid.Column="1" Background="{DynamicResource PanelBrush}"
                Padding="30,26,30,16">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="YOUR WORKSPACE" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding CurrentCategoryTitle}" FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource InkBrush}"/>
                <TextBlock Text="{Binding CurrentCategorySubtitle}" FontSize="13"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
              </StackPanel>
              <Button HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Style="{DynamicResource PrimaryButton}" Command="{Binding AddFolderCommand}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="＋" FontSize="16" Margin="0,0,4,0" VerticalAlignment="Center"/>
                  <TextBlock Text="添加文件夹" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Grid>

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16" LastChildFill="True">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="{Binding ResultCountText}" FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="▦" ToolTip="网格视图" Command="{Binding SetGridViewCommand}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ViewButton}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGridMode}" Value="True">
                          <Setter Property="Tag" Value="active"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
                <Button Content="☷" ToolTip="列表视图" Margin="4,0,0,0"
                        Command="{Binding SetListViewCommand}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ViewButton}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsListMode}" Value="True">
                          <Setter Property="Tag" Value="active"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </StackPanel>
              <Border x:Name="SearchBorder" Height="40" BorderBrush="{DynamicResource LineStrongBrush}"
                      BorderThickness="1" CornerRadius="10" Background="{DynamicResource PanelSoftBrush}"
                      GotKeyboardFocus="SearchBorder_GotKeyboardFocus"
                      LostKeyboardFocus="SearchBorder_LostKeyboardFocus">
                <DockPanel Margin="12,0">
                  <TextBlock DockPanel.Dock="Left" Text="⌕" FontSize="18"
                             Foreground="{DynamicResource MutedBrush}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <Border DockPanel.Dock="Right" Background="{DynamicResource KbdBgBrush}"
                          BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                          CornerRadius="5" Padding="6,3" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Ctrl+K" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                  </Border>
                  <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                           VerticalContentAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource InkBrush}" CaretBrush="{DynamicResource InkBrush}"
                           Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
              </Border>
            </DockPanel>

            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                    Padding="0,12,0,0" Margin="0,10,0,0">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource StatusDotBrush}"
                         Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                           Foreground="{DynamicResource MutedBrush}"/>
              </StackPanel>
            </Border>

            <Grid>
              <ScrollViewer x:Name="FolderScroll"
                            VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                            Padding="2,4,6,10"
                            Style="{DynamicResource FolderHubScrollViewer}">
                <ItemsControl x:Name="FolderItems" ItemsSource="{Binding Folders}"
                              HorizontalAlignment="Stretch"
                              Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                  <!-- ItemsPanel 由 MainWindow 按 IsListMode 切换：Style Trigger 改 ItemsPanel 在 WPF 中不可靠 -->
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                      <Setter Property="HorizontalAlignment" Value="Stretch"/>
                      <Setter Property="VerticalAlignment" Value="Top"/>
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FolderListItem}">
                      <!-- 外环：选中时 2px accent-soft（对齐 demo box-shadow ring）；间距对齐 gap:12
                           Width/HorizontalAlignment/Margin 只用 Style，避免本地值压过列表模式 Trigger -->
                      <Border Padding="2" CornerRadius="14" VerticalAlignment="Top"
                              SnapsToDevicePixels="True">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="Margin" Value="0,0,12,12"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding DataContext.IsListMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Margin" Value="0,0,0,12"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Border Padding="14" CornerRadius="12" Cursor="Hand"
                                BorderThickness="1" Background="{DynamicResource PanelBrush}"
                                MouseLeftButtonUp="FolderCard_MouseLeftButtonUp"
                                MouseRightButtonUp="FolderCard_MouseRightButtonUp"
                                MouseLeftButtonDown="FolderCard_MouseLeftButtonDown"
                                MouseEnter="FolderCard_MouseEnter"
                                MouseLeave="FolderCard_MouseLeave"
                                Tag="{Binding}"
                                RenderTransformOrigin="0.5,0.5">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Width" Value="{StaticResource DoubleAuto}"/>
                              <Setter Property="MinHeight" Value="{StaticResource FolderCardMinHeight}"/>
                              <Setter Property="HorizontalAlignment" Value="Stretch"/>
                              <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                  <Setter Property="BorderBrush" Value="{DynamicResource AccentMidBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPathUnavailable}" Value="True">
                                  <Setter Property="BorderBrush" Value="{DynamicResource UnavailableBorderBrush}"/>
                                  <Setter Property="Background" Value="{DynamicResource UnavailableBgBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.IsListMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                  <Setter Property="MinHeight" Value="0"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <!-- DockPanel：底栏贴底（demo folder-bottom margin-top:auto）；说明最多 2 行 line-clamp -->
                          <DockPanel LastChildFill="True">
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="True">
                              <Button DockPanel.Dock="Right" Content="{Binding PinLabel}"
                                      Style="{DynamicResource PinToggleButton}"
                                      Margin="8,0,0,0" Click="Pin_Click" Tag="{Binding}"/>
                              <TextBlock Text="{Binding PathStatusLabel}" FontSize="12"
                                         FontFamily="{DynamicResource CardTextFontFamily}"
                                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                         Opacity="0.72">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsPathUnavailable}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource UnavailableInkBrush}"/>
                                        <Setter Property="Opacity" Value="1"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </DockPanel>

                            <StackPanel>
                            <DockPanel LastChildFill="False">
                              <!-- design-demo .folder-icon：40×40 / radius 11；WPF 彩色 emoji 常空白，改用 images PNG -->
                              <Border Width="40" Height="40" CornerRadius="11" ClipToBounds="True"
                                      Background="{Binding IconTone}">
                                <Grid>
                                  <Image Source="{Binding IconImage}" Stretch="Uniform" Margin="4"
                                         Visibility="{Binding HasIconImage, Converter={StaticResource BoolToVis}}"/>
                                  <TextBlock Text="{Binding IconGlyph}" FontSize="20"
                                             FontFamily="Segoe UI Emoji, Segoe UI Symbol, Microsoft YaHei UI"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             TextAlignment="Center">
                                    <TextBlock.Style>
                                      <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding HasIconImage}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </TextBlock.Style>
                                  </TextBlock>
                                </Grid>
                              </Border>
                              <Button DockPanel.Dock="Right" Content="···" Width="26" Height="26"
                                      Background="Transparent" BorderThickness="0"
                                      Foreground="{DynamicResource MutedSoftBrush}" FontSize="16"
                                      VerticalAlignment="Top" Click="FolderMore_Click"
                                      Cursor="Hand" Tag="{Binding}">
                                <Button.Template>
                                  <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                      <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}"/>
                                      </Trigger>
                                    </ControlTemplate.Triggers>
                                  </ControlTemplate>
                                </Button.Template>
                              </Button>
                            </DockPanel>

                            <TextBlock Text="{Binding Title}" Margin="0,12,0,0"
                                       FontSize="14" FontWeight="Bold"
                                       FontFamily="{DynamicResource CardTextFontFamily}"
                                       Foreground="{DynamicResource InkBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" Margin="0,3,0,0"
                                       FontSize="12"
                                       FontFamily="{DynamicResource CardTextFontFamily}"
                                       Foreground="{DynamicResource InkSoftBrush}" Opacity="0.78"
                                       TextTrimming="CharacterEllipsis"/>
                            <Border Margin="0,8,0,0" MaxHeight="36" ClipToBounds="True">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsListMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                      <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <TextBlock Text="{Binding Description}"
                                         FontSize="12" LineHeight="18"
                                         FontFamily="{DynamicResource CardTextFontFamily}"
                                         Foreground="{DynamicResource MutedBrush}"
                                         TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                         VerticalAlignment="Top"/>
                            </Border>
                            </StackPanel>
                          </DockPanel>
                        </Border>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="⌕" FontSize="32" HorizontalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                <TextBlock Text="没有找到匹配的文件夹" FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource InkSoftBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="试试其他名称或别名" FontSize="13"
                           Foreground="{DynamicResource MutedBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
              </StackPanel>
            </Grid>
          </DockPanel>
        </Border>
      </Grid>

      <TextBlock Grid.Row="1" Text="⋰" FontSize="14" Foreground="{DynamicResource MutedSoftBrush}"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,2"
                 IsHitTestVisible="False"/>
    </Grid>
    </Border>
  </Grid>
</Window>
