<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FolderHub.Infrastructure\FolderHub.Infrastructure.csproj" />
    <ProjectReference Include="..\FolderHub.Domain\FolderHub.Domain.csproj" />
    <ProjectReference Include="..\FolderHub.UseCases\FolderHub.UseCases.csproj" />
    <!-- 确保 `dotnet build/run` App 时一并编译 CardHost，便于按相对路径启动。 -->
    <ProjectReference Include="..\FolderHub.CardHost\FolderHub.CardHost.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\FolderHub.ico</ApplicationIcon>
    <AssemblyTitle>FolderHub</AssemblyTitle>
    <Product>FolderHub</Product>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Fonts\DMSans-Regular.ttf"/>
  </ItemGroup>

  <!-- WinForms 全局 using 与 WPF 类型冲突；托盘代码使用完整限定名。 -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Drawing.Imaging" />
    <Using Remove="System.Drawing.Printing" />
  </ItemGroup>

  <!-- 发布/本机运行时 CardHost 须与 App 同目录（ResolveCardHostExePath 优先 sibling）；保留 runtimes 等子目录。 -->
  <Target Name="CopyCardHostBesideApp" AfterTargets="Build">
    <PropertyGroup>
      <_CardHostOutDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\FolderHub.CardHost\bin\$(Configuration)\$(TargetFramework)\'))</_CardHostOutDir>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(_CardHostOutDir)')">
      <_CardHostFiles Include="$(_CardHostOutDir)**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_CardHostFiles)"
      DestinationFiles="@(_CardHostFiles->'$(TargetDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(_CardHostFiles)' != ''" />
  </Target>

</Project>
