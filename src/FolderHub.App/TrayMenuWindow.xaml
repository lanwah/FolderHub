<Window x:Class="FolderHub.App.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FolderHub"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        FontFamily="{DynamicResource AppFontFamily}"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">
  <!-- design-demo .tray-popover：圆角面板 + 标题 + accent 悬停菜单项 -->
  <Border Margin="16"
          MinWidth="200"
          Padding="8"
          Background="{DynamicResource PanelBrush}"
          BorderBrush="{DynamicResource LineBrush}"
          BorderThickness="1"
          CornerRadius="12"
          SnapsToDevicePixels="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="32" ShadowDepth="12" Opacity="0.22" Color="#0D2428"/>
    </Border.Effect>
    <StackPanel>
      <TextBlock Text="FolderHub"
                 Padding="8,8,8,10"
                 FontSize="13"
                 FontWeight="Bold"
                 Foreground="{DynamicResource InkBrush}"/>
      <MenuItem Style="{StaticResource AppMenuItem}"
                Header="▣　打开主界面"
                Click="OpenMain_Click"/>
      <MenuItem Style="{StaticResource AppMenuItem}"
                Header="⚙　设置"
                Click="OpenSettings_Click"/>
      <MenuItem Style="{StaticResource AppMenuItem}"
                Header="↻　恢复桌面卡片"
                Click="RecoverCards_Click"/>
      <Separator Style="{StaticResource AppMenuSeparator}"/>
      <MenuItem Style="{StaticResource AppMenuItem}"
                Header="⏻　退出应用"
                Click="Exit_Click"/>
    </StackPanel>
  </Border>
</Window>
