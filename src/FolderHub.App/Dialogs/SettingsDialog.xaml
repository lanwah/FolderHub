<Window x:Class="FolderHub.App.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="420" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFFFFF"
        FontFamily="Segoe UI, Microsoft YaHei UI">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="设置" FontSize="17" FontWeight="SemiBold" Foreground="#1B2B31"/>
      <TextBlock Text="FolderHub 桌面组件与运行偏好" FontSize="11" Foreground="#8B9893" Margin="0,6,0,0"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,10,0,0">
      <Border BorderBrush="#EDF1EE" BorderThickness="0,1,0,0" Padding="0,14">
        <Grid>
          <StackPanel>
            <TextBlock Text="主组件固定到桌面" FontWeight="SemiBold" FontSize="12"/>
            <TextBlock Text="开启后主组件显示在桌面壁纸层；当前版本先记录偏好（WP9）"
                       FontSize="10" Foreground="#8B9892" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
          <CheckBox x:Name="PinBox" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <Border BorderBrush="#EDF1EE" BorderThickness="0,1,0,0" Padding="0,14">
        <Grid>
          <StackPanel>
            <TextBlock Text="锁定主组件位置" FontWeight="SemiBold" FontSize="12"/>
            <TextBlock Text="锁定后不可拖动或调整位置"
                       FontSize="10" Foreground="#8B9892" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
          <CheckBox x:Name="LockBox" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <Border BorderBrush="#EDF1EE" BorderThickness="0,1,0,0" Padding="0,14">
        <Grid>
          <StackPanel>
            <TextBlock Text="退出主程序后保留独立卡片" FontWeight="SemiBold" FontSize="12"/>
            <TextBlock Text="全局统一开关，默认开启；不提供逐卡片覆盖"
                       FontSize="10" Foreground="#8B9892" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
          <CheckBox x:Name="KeepCardsBox" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <Border BorderBrush="#EDF1EE" BorderThickness="0,1,0,0" Padding="0,14">
        <StackPanel>
          <Grid>
            <StackPanel>
              <TextBlock Text="背景透明度" FontWeight="SemiBold" FontSize="12"/>
              <TextBlock Text="范围 20%～100%；当前以面板背景透明度近似"
                         FontSize="10" Foreground="#8B9892" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock x:Name="OpacityLabel" HorizontalAlignment="Right" VerticalAlignment="Top"
                       FontWeight="Bold" Foreground="#287C70" FontSize="12"/>
          </Grid>
          <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" TickFrequency="1"
                  IsSnapToTickEnabled="True" Margin="0,12,0,0"
                  ValueChanged="OpacitySlider_OnValueChanged"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" Width="72" Height="32" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"
              Background="White" BorderBrush="#E2E9E5" Foreground="#64716B"/>
      <Button Content="完成" Width="84" Height="32" IsDefault="True" Click="Save_Click"
              Background="#287C70" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
    </StackPanel>
  </Grid>
</Window>
