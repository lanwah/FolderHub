<Window x:Class="FolderHub.App.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="600" Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="14"
        Foreground="{DynamicResource InkBrush}">
  <!-- design-demo .modal：16px 圆角，无系统标题栏 -->
  <Border Margin="12" CornerRadius="16" Padding="24"
          BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
          Background="{DynamicResource PanelBrush}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="40" ShadowDepth="16" Opacity="0.28" Color="#061820"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <DockPanel Margin="0,0,0,18" LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="×" Style="{DynamicResource ModalCloseButton}"
                VerticalAlignment="Top" Click="Cancel_Click" ToolTip="关闭"/>
        <StackPanel>
          <TextBlock Text="设置" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
          <TextBlock Text="FolderHub 桌面组件与运行偏好" FontSize="13"
                     Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
        </StackPanel>
      </DockPanel>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14">
            <Grid>
              <StackPanel Margin="0,0,120,0">
                <TextBlock Text="界面主题" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource InkBrush}"/>
                <TextBlock Text="浅色 / 深色可随时切换；选择会保存在本机"
                           FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
              </StackPanel>
              <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                      BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                      CornerRadius="9" Background="{DynamicResource PanelSoftBrush}" Padding="3">
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="ThemeLightBtn" Content="浅色" Style="{DynamicResource ThemeToggleButton}"
                          Click="ThemeLight_Click"/>
                  <Button x:Name="ThemeDarkBtn" Content="深色" Style="{DynamicResource ThemeToggleButton}"
                          Click="ThemeDark_Click"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14">
            <Grid>
              <StackPanel Margin="0,0,40,0">
                <TextBlock Text="开机启动" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource InkBrush}"/>
                <TextBlock Text="登录当前 Windows 用户后自动启动 FolderHub（托盘常驻）"
                           FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
              </StackPanel>
              <CheckBox x:Name="StartupBox" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14">
            <Grid>
              <StackPanel Margin="0,0,40,0">
                <TextBlock Text="主组件固定到桌面" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource InkBrush}"/>
                <TextBlock Text="开启后主组件显示在桌面壁纸层"
                           FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
              </StackPanel>
              <CheckBox x:Name="PinBox" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14">
            <Grid>
              <StackPanel Margin="0,0,40,0">
                <TextBlock Text="锁定主组件位置" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource InkBrush}"/>
                <TextBlock Text="锁定后不可拖动或调整位置"
                           FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
              </StackPanel>
              <CheckBox x:Name="LockBox" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14">
            <Grid>
              <StackPanel Margin="0,0,40,0">
                <TextBlock Text="退出主程序后保留独立卡片" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource InkBrush}"/>
                <TextBlock Text="全局统一开关，默认开启；不提供逐卡片覆盖"
                           FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
              </StackPanel>
              <CheckBox x:Name="KeepCardsBox" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14">
            <StackPanel>
              <Grid>
                <StackPanel Margin="0,0,60,0">
                  <TextBlock Text="背景透明度" FontWeight="SemiBold" FontSize="13"
                             Foreground="{DynamicResource InkBrush}"/>
                  <TextBlock Text="仅调整主组件背景，文字和图标保持不透明"
                             FontSize="12" Foreground="{DynamicResource MutedBrush}"
                             TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock x:Name="OpacityLabel" HorizontalAlignment="Right" VerticalAlignment="Top"
                           FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FontSize="13"/>
              </Grid>
              <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" TickFrequency="1"
                      IsSnapToTickEnabled="True" Margin="0,12,0,0"
                      ValueChanged="OpacitySlider_OnValueChanged"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button Content="取消" Width="72" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"
                Style="{DynamicResource SecondaryButton}"/>
        <Button Content="完成" Width="84" IsDefault="True" Click="Save_Click"
                Style="{DynamicResource ModalPrimaryButton}"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
