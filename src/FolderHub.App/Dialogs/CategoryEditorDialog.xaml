<Window x:Class="FolderHub.App.Dialogs.CategoryEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="分类" Height="280" Width="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="14"
        Foreground="{DynamicResource InkBrush}">
  <Border Margin="12" CornerRadius="16" Padding="24"
          BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
          Background="{DynamicResource PanelBrush}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="40" ShadowDepth="16" Opacity="0.28" Color="#061820"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="×" Style="{DynamicResource ModalCloseButton}"
                VerticalAlignment="Top" Click="Cancel_Click" ToolTip="关闭"/>
        <StackPanel>
          <TextBlock x:Name="TitleText" Text="新增分类" FontSize="18" FontWeight="Bold"
                     Foreground="{DynamicResource InkBrush}"/>
          <TextBlock Text="分类为平级列表，不支持嵌套" FontSize="13"
                     Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
        </StackPanel>
      </DockPanel>

      <StackPanel Grid.Row="1" Margin="0,18,0,0">
        <TextBlock Text="分类名称 *" Style="{DynamicResource FormFieldLabel}"/>
        <TextBox x:Name="NameBox" Style="{DynamicResource FormTextBox}"/>
      </StackPanel>

      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button Content="取消" Width="72" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"
                Style="{DynamicResource SecondaryButton}"/>
        <Button Content="保存" Width="84" IsDefault="True" Click="Save_Click"
                Style="{DynamicResource ModalPrimaryButton}"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
