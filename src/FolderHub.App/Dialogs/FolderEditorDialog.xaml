<Window x:Class="FolderHub.App.Dialogs.FolderEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件夹" Height="520" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFFFFF"
        FontFamily="Segoe UI, Microsoft YaHei UI">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock x:Name="TitleText" Text="添加文件夹" FontSize="17" FontWeight="SemiBold" Foreground="#1B2B31"/>
      <TextBlock Text="维护文件夹记录、别名和用途说明" FontSize="11" Foreground="#8B9893" Margin="0,6,0,0"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="文件夹名称 *" FontSize="11" FontWeight="SemiBold" Foreground="#586760"/>
        <TextBox x:Name="NameBox" Margin="0,7,0,12" Padding="10,8" FontSize="12"
                 BorderBrush="#E3EAE6" Background="#FBFCFB"/>

        <TextBlock Text="别名（可选）" FontSize="11" FontWeight="SemiBold" Foreground="#586760"/>
        <TextBox x:Name="AliasBox" Margin="0,7,0,12" Padding="10,8" FontSize="12"
                 BorderBrush="#E3EAE6" Background="#FBFCFB"/>

        <TextBlock Text="真实路径 *" FontSize="11" FontWeight="SemiBold" Foreground="#586760"/>
        <TextBox x:Name="PathBox" Margin="0,7,0,12" Padding="10,8" FontSize="12"
                 BorderBrush="#E3EAE6" Background="#FBFCFB"/>

        <TextBlock Text="用途说明" FontSize="11" FontWeight="SemiBold" Foreground="#586760"/>
        <TextBox x:Name="DescBox" Margin="0,7,0,12" Padding="10,8" FontSize="12" Height="72"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 BorderBrush="#E3EAE6" Background="#FBFCFB"/>

        <TextBlock Text="所属分类" FontSize="11" FontWeight="SemiBold" Foreground="#586760"/>
        <ListBox x:Name="CategoryList" Margin="0,7,0,0" Height="110" SelectionMode="Multiple"
                 BorderBrush="#E3EAE6" Background="#FBFCFB" DisplayMemberPath="Name"/>
        <TextBlock Text="按住 Ctrl 可选择多个分类；分类为平级关系"
                   FontSize="10" Foreground="#96A19B" Margin="0,6,0,0"/>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="取消" Width="72" Height="32" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"
              Background="White" BorderBrush="#E2E9E5" Foreground="#64716B"/>
      <Button Content="保存记录" Width="96" Height="32" IsDefault="True" Click="Save_Click"
              Background="#287C70" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
    </StackPanel>
  </Grid>
</Window>
