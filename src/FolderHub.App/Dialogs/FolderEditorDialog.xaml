<Window x:Class="FolderHub.App.Dialogs.FolderEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件夹" Height="640" Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="14"
        Foreground="{DynamicResource InkBrush}">
  <Border Margin="12" CornerRadius="16" Padding="24"
          BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
          Background="{DynamicResource PanelBrush}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="40" ShadowDepth="16" Opacity="0.28" Color="#061820"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <DockPanel Margin="0,0,0,18" LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="×" Style="{DynamicResource ModalCloseButton}"
                VerticalAlignment="Top" Click="Cancel_Click" ToolTip="关闭"/>
        <StackPanel>
          <TextBlock x:Name="TitleText" Text="添加文件夹" FontSize="18" FontWeight="Bold"
                     Foreground="{DynamicResource InkBrush}"/>
          <TextBlock Text="维护文件夹记录、别名和用途说明" FontSize="13"
                     Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
        </StackPanel>
      </DockPanel>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Style="{DynamicResource FolderHubScrollViewer}">
        <StackPanel>
          <TextBlock Text="文件夹名称 *" Style="{DynamicResource FormFieldLabel}"/>
          <TextBox x:Name="NameBox" Style="{DynamicResource FormTextBox}" Margin="0,0,0,14"/>

          <TextBlock Text="别名（可选）" Style="{DynamicResource FormFieldLabel}"/>
          <TextBox x:Name="AliasBox" Style="{DynamicResource FormTextBox}" Margin="0,0,0,14"/>

          <TextBlock Text="真实路径 *" Style="{DynamicResource FormFieldLabel}"/>
          <TextBox x:Name="PathBox" Style="{DynamicResource FormTextBox}" Margin="0,0,0,14"/>

          <TextBlock Text="用途说明" Style="{DynamicResource FormFieldLabel}"/>
          <TextBox x:Name="DescBox" Style="{DynamicResource FormTextBox}" Height="72" Margin="0,0,0,14"
                   TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

          <TextBlock Text="图标" Style="{DynamicResource FormFieldLabel}"/>
          <WrapPanel x:Name="IconPanel" Margin="0,0,0,14"/>

          <TextBlock Text="所属分类" Style="{DynamicResource FormFieldLabel}"/>
          <ListBox x:Name="CategoryList" Height="110" SelectionMode="Multiple"
                   BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1"
                   Background="{DynamicResource InputBgBrush}"
                   Foreground="{DynamicResource InkBrush}"
                   DisplayMemberPath="Name"/>
          <TextBlock Text="按住 Ctrl 可选择多个分类；分类为平级关系"
                     FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button Content="取消" Width="72" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"
                Style="{DynamicResource SecondaryButton}"/>
        <Button Content="保存记录" Width="96" IsDefault="True" Click="Save_Click"
                Style="{DynamicResource ModalPrimaryButton}"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
