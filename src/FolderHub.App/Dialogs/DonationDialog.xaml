<Window x:Class="FolderHub.App.Dialogs.DonationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buy me a coffee"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="14"
        Foreground="{DynamicResource InkBrush}">
  <Border Margin="12" CornerRadius="16" Padding="24"
          BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
          Background="{DynamicResource PanelBrush}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="40" ShadowDepth="16" Opacity="0.28" Color="#061820"/>
    </Border.Effect>
    <StackPanel>
      <DockPanel Margin="0,0,0,16" LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="×" Style="{DynamicResource ModalCloseButton}"
                VerticalAlignment="Top" Click="Close_Click" ToolTip="Close"/>
        <StackPanel>
          <TextBlock Text="Buy me a coffee" FontSize="18" FontWeight="Bold"
                     Foreground="{DynamicResource InkBrush}"/>
          <TextBlock Text="Voluntary support keeps FolderHub free and maintained — thank you."
                     FontSize="12" Foreground="{DynamicResource MutedBrush}"
                     TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
      </DockPanel>

      <TextBlock Text="Scan with WeChat or Alipay — any amount is appreciated."
                 FontSize="12" Foreground="{DynamicResource MutedBrush}"
                 TextWrapping="Wrap" Margin="0,0,0,14"/>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" CornerRadius="12" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1" Background="{DynamicResource PanelSoftBrush}" Padding="10">
          <StackPanel>
            <TextBlock Text="WeChat Pay" FontWeight="SemiBold" FontSize="13"
                       HorizontalAlignment="Center" Margin="0,0,0,8"
                       Foreground="{DynamicResource InkBrush}"/>
            <Image x:Name="WeixinImg" Stretch="Uniform" MaxWidth="200"
                   HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" CornerRadius="12" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1" Background="{DynamicResource PanelSoftBrush}" Padding="10">
          <StackPanel>
            <TextBlock Text="Alipay" FontWeight="SemiBold" FontSize="13"
                       HorizontalAlignment="Center" Margin="0,0,0,8"
                       Foreground="{DynamicResource InkBrush}"/>
            <Image x:Name="AlipayImg" Stretch="Uniform" MaxWidth="200"
                   HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>

      <TextBlock Text="自愿捐赠，无金额要求。若扫码不便，也可截图后用手机打开。"
                 FontSize="11" Foreground="{DynamicResource MutedSoftBrush}"
                 TextWrapping="Wrap" Margin="0,14,0,0" TextAlignment="Center"/>
    </StackPanel>
  </Border>
</Window>