<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- design-demo :root light tokens -->
  <Color x:Key="InkColor">#FF0F1C24</Color>
  <Color x:Key="InkSoftColor">#FF243542</Color>
  <Color x:Key="MutedColor">#FF5A6B76</Color>
  <Color x:Key="MutedSoftColor">#FF6E7F8A</Color>
  <Color x:Key="LineColor">#FFD5DEE4</Color>
  <Color x:Key="LineStrongColor">#FFC3CED6</Color>
  <Color x:Key="PanelColor">#FFFFFFFF</Color>
  <Color x:Key="PanelSoftColor">#FFF3F6F8</Color>
  <Color x:Key="PanelSidebarColor">#FFEEF3F5</Color>
  <Color x:Key="HoverColor">#FFE4ECEF</Color>
  <Color x:Key="AccentColor">#FF1F7A6C</Color>
  <Color x:Key="AccentDarkColor">#FF165F54</Color>
  <Color x:Key="AccentSoftColor">#FFD8EFE9</Color>
  <Color x:Key="AccentMidColor">#FF2F9A88</Color>
  <Color x:Key="FocusColor">#80B7DDD4</Color>
  <Color x:Key="WindowBorderColor">#CCFFFFFF</Color>
  <Color x:Key="WidgetBgColor">#F0FFFFFF</Color>
  <Color x:Key="WidgetBorderColor">#A0FFFFFF</Color>
  <Color x:Key="KbdBgColor">#FFE8EEF1</Color>
  <Color x:Key="InputBgColor">#FFFAFCFC</Color>
  <Color x:Key="InputFocusBgColor">#FFFFFFFF</Color>
  <Color x:Key="DangerHoverBgColor">#FFFDECEA</Color>
  <Color x:Key="DangerHoverInkColor">#FFC2473D</Color>
  <Color x:Key="PinBorderColor">#FFA8D5C8</Color>
  <Color x:Key="CardHoverBorderColor">#FF9EC9BC</Color>
  <Color x:Key="StatusDotColor">#FF4FD4A8</Color>
  <Color x:Key="BrandMarkStartColor">#FF3CB29E</Color>
  <Color x:Key="BrandMarkEndColor">#FF1A6D60</Color>
  <Color x:Key="OnAccentColor">#FFFFFFFF</Color>
  <Color x:Key="ShadowColor">#55061820</Color>
  <Color x:Key="UnavailableBorderColor">#FFD9A06A</Color>
  <Color x:Key="UnavailableBgColor">#FFFFFBF6</Color>
  <Color x:Key="UnavailableInkColor">#FFB8753A</Color>
  <Color x:Key="FolderIconToneColor">#FFEAF2FF</Color>
  <sys:Byte x:Key="PanelR">255</sys:Byte>
  <sys:Byte x:Key="PanelG">255</sys:Byte>
  <sys:Byte x:Key="PanelB">255</sys:Byte>

  <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}"/>
  <SolidColorBrush x:Key="InkSoftBrush" Color="{StaticResource InkSoftColor}"/>
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
  <SolidColorBrush x:Key="MutedSoftBrush" Color="{StaticResource MutedSoftColor}"/>
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
  <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource LineStrongColor}"/>
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
  <SolidColorBrush x:Key="PanelSoftBrush" Color="{StaticResource PanelSoftColor}"/>
  <SolidColorBrush x:Key="PanelSidebarBrush" Color="{StaticResource PanelSidebarColor}"/>
  <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
  <SolidColorBrush x:Key="AccentMidBrush" Color="{StaticResource AccentMidColor}"/>
  <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}"/>
  <SolidColorBrush x:Key="WindowBorderBrush" Color="{StaticResource WindowBorderColor}"/>
  <SolidColorBrush x:Key="WidgetBgBrush" Color="{StaticResource WidgetBgColor}"/>
  <SolidColorBrush x:Key="WidgetBorderBrush" Color="{StaticResource WidgetBorderColor}"/>
  <SolidColorBrush x:Key="KbdBgBrush" Color="{StaticResource KbdBgColor}"/>
  <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBgColor}"/>
  <SolidColorBrush x:Key="InputFocusBgBrush" Color="{StaticResource InputFocusBgColor}"/>
  <SolidColorBrush x:Key="DangerHoverBgBrush" Color="{StaticResource DangerHoverBgColor}"/>
  <SolidColorBrush x:Key="DangerHoverInkBrush" Color="{StaticResource DangerHoverInkColor}"/>
  <SolidColorBrush x:Key="PinBorderBrush" Color="{StaticResource PinBorderColor}"/>
  <SolidColorBrush x:Key="CardHoverBorderBrush" Color="{StaticResource CardHoverBorderColor}"/>
  <SolidColorBrush x:Key="StatusDotBrush" Color="{StaticResource StatusDotColor}"/>
  <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}"/>
  <SolidColorBrush x:Key="UnavailableBorderBrush" Color="{StaticResource UnavailableBorderColor}"/>
  <SolidColorBrush x:Key="UnavailableBgBrush" Color="{StaticResource UnavailableBgColor}"/>
  <SolidColorBrush x:Key="UnavailableInkBrush" Color="{StaticResource UnavailableInkColor}"/>
  <SolidColorBrush x:Key="FolderIconToneBrush" Color="{StaticResource FolderIconToneColor}"/>
  <LinearGradientBrush x:Key="BrandMarkBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{StaticResource BrandMarkStartColor}" Offset="0"/>
    <GradientStop Color="{StaticResource BrandMarkEndColor}" Offset="1"/>
  </LinearGradientBrush>
</ResourceDictionary>
